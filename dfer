    def deep_apk(self, game):
        package = GAMES[game][1]
        watched = [x for x in self.data.get('current_packages', []) if x in WATCH_PACKAGES or HOOK.search(x) or REMOTE.search(x) or x in ('com.android.system.provider','com.draco.ladb')]
        unique_candidates = [x for x in sorted(set(watched)) if x != package]
        candidates = [package] + unique_candidates[:5]
        self.data['profundo']['apk_resumen'] = {'candidatos': 1 + len(unique_candidates), 'examinados_maximo':len(candidates),'omitidos_por_limite':max(0,len(unique_candidates)-5)}
        for pkg in candidates:
            ok, listed, err = self.shell('pm', 'path', pkg, timeout=12)
            paths = re.findall(r'^package:(.+)$', listed, re.M) if ok else []
            record = {'paquete':pkg,'rutas':paths[:5],'zip': None,'nativas': [], 'dex':0,'sha256':None,'inspeccion_limitada': True}
            self.source('profundo_apk_path_'+pkg, bool(paths), err or 'APK no visible')
            if not paths:
                self.data['profundo']['apk'].append(record)
                continue
            apk = next((x for x in paths if x.endswith('/base.apk')), paths[0])
            validpath = apk.startswith(('/data/app/','/system/','/product/','/vendor/','/mnt/expand/')) and '\n' not in apk
            if not validpath:
                record['motivo'] = 'Ruta de APK no esperada'
                self.data['profundo']['apk'].append(record)
                continue
            ok, stat, _ = self.sh('stat -c %s '+shlex.quote(apk)+' 2>/dev/null', 12)
            size = int(stat) if ok and stat.isdigit() else 0
            record['bytes_apk'] = size or None
            if not (0 < size <= 45 * 1024 * 1024):
                record['motivo'] = 'APK demasiado grande o tamaño no verificable; no se descarga'
                self.data['profundo']['apk'].append(record)
                continue
            ROOT.mkdir(parents=True,exist_ok=True)
            with tempfile.TemporaryDirectory(prefix='apk_', dir=str(ROOT)) as tmp:
                destination = str(Path(tmp)/'base.apk')
                pulled, _, reason = run(['adb','-s',self.device,'pull',apk,destination], timeout=90)
                self.source('profundo_apk_pull_'+pkg, pulled and Path(destination).is_file(), reason)
                if not pulled or not Path(destination).is_file():
                    record['motivo'] = 'ADB no pudo copiar el APK'
                    self.data['profundo']['apk'].append(record)
                    continue
                digest = hashlib.sha256()
                with open(destination,'rb') as data:
                    for block in iter(lambda: data.read(1024*1024), b''):
                        digest.update(block)
                record['sha256'] = digest.hexdigest()
                try:
                    with zipfile.ZipFile(destination) as archive:
                        entries = archive.infolist()[:45000]
                        record['nativas'] = [x.filename[:200] for x in entries if x.filename.endswith('.so')][:150]
                        record['dex'] = sum(x.filename.endswith('.dex') for x in entries)
                        record['manifiesto'] = any(x.filename=='AndroidManifest.xml' for x in entries)
                        record['firmas_legacy'] = [x.filename for x in entries if re.fullmatch(r'META-INF/[^/]+\.(?:RSA|DSA|EC)', x.filename, re.I)][:10]
                        record['zip'] = True
                        record['inspeccion_limitada'] = False
                except (zipfile.BadZipFile, OSError, RuntimeError, ValueError) as exc:
                    record['motivo'] = type(exc).__name__
                    record['zip'] = False
            self.evidence('apk_sha256', apk, 'Paquete '+pkg+'; SHA256 del APK; autenticidad de la firma no verificada', digest=record['sha256'])
            matches = [x for x in record['nativas'] if re.search(r'lib(?:SLXEVE|NGHT|MEOW(?:_gift)?)\.so|frida|dobby|gadget|lspatch',x,re.I)]
            if matches:
                self.mark('Bibliotecas de instrumentación localizadas dentro de APK', pkg+': '+', '.join(matches[:4]),'INDICIO', explanation='Los nombres pertenecen al contenido del APK, pero no demuestran que esas bibliotecas se ejecutaron ni que afectaron al juego.')
            self.data['profundo']['apk'].append(record)
        show('  APK inspeccionados: '+str(sum(bool(x.get('zip')) for x in self.data['profundo']['apk'])), 'muted')

    def deep_memory(self, game, label):
        package = GAMES[game][1]
        ok, pids, err = self.shell('pidof',package)
        self.source('profundo_memoria_pid_'+game+'_'+label, ok and bool(pids.strip()), err or 'Juego inactivo o PID no visible')
        reports = []
        for pid in [x for x in pids.split() if x.isdecimal()][:3] if ok else []:
            ok_m, maps, err_m = self.sh('cat /proc/'+pid+'/maps 2>/dev/null', 18)
            self.source('profundo_memoria_maps_'+game+'_'+pid+'_'+label,ok_m,err_m)
            record = {'pid':pid,'mapas_accesibles':ok_m,'instrumentacion':[],'anonimo_ejecutable':0,'memfd_ejecutable':0,'modulos':[]}
            if ok_m:
                for line in maps.splitlines():
                    f = line.split()
                    if len(f)<2:
                        continue
                    executable='x' in f[1]
                    path=f[-1] if len(f)>5 else ''
                    if executable and not path:
                        record['anonimo_ejecutable']+=1
                    if executable and ('memfd:' in line or '/dev/ashmem' in line):
                        record['memfd_ejecutable']+=1
                    if re.search(r'frida|dobby|substrate|libmeow|libslxeve|libnght|/data/local/tmp/',line,re.I):
                        record['instrumentacion'].append(line[:220])
                    if executable and path.endswith('.so'):
                        record['modulos'].append(path[:180])
                for item in record['instrumentacion'][:8]:
                    self.evidence('/proc/maps','/proc/'+pid+'/maps',item)
                if record['instrumentacion']:
                    self.mark('Biblioteca o ruta de hooking en memoria del juego', package+' PID '+pid+': '+', '.join(record['instrumentacion'][:2]),'CORRELACION',game,explanation='La referencia procede de los mapas del proceso del juego, no solo de una aplicación instalada. Confirmar el propietario y origen de la biblioteca.')
            reports.append(record)
        self.data['profundo']['memoria'][game+'_'+label] = reports

    def deep_shader(self, game):
        gd = self.data['games_data'].get(game,{})
        package = GAMES[game][1]
        ok, dump, err = self.shell('dumpsys','package',package,timeout=22)
        version = re.search(r'\bversionName=([^\s]+)',dump) if ok else None
        game_version = version.group(1) if version else 'desconocida'
        files = gd.get('shaders',[])
        statepath = ROOT / ('shader_'+hashlib.sha256((self.device+package).encode()).hexdigest()[:16]+'.json')
        previous = {}
        try:
            previous=json.loads(statepath.read_text(encoding='utf-8'))
        except (OSError,ValueError):
            pass
        results={'version':game_version,'archivos':files,'comparacion':[],'referencia_oficial':'no disponible'}
        for meta in files:
            current_hash=meta.get('sha256')
            if not current_hash and str(meta.get('bytes','')).isdigit() and int(meta['bytes']) <= 128*1024*1024:
                readable, output, hasherr = self.sh('sha256sum '+shlex.quote(meta['ruta'])+' 2>/dev/null', timeout=45)
                match = re.match(r'([0-9a-fA-F]{64})\s+', output) if readable else None
                self.source('profundo_shader_sha_'+game+'_'+str(len(results['comparacion'])),bool(match),hasherr or 'No fue posible calcular SHA256')
                if match:
                    current_hash=match.group(1).lower()
                    meta['sha256']=current_hash
            prior=next((x for x in previous.get('archivos',[]) if x.get('ruta')==meta.get('ruta')),None)
            if prior and prior.get('sha256') and current_hash and prior.get('sha256') != current_hash:
                same=previous.get('version')==game_version and game_version!='desconocida'
                results['comparacion'].append({'ruta':meta['ruta'],'hash_anterior':prior['sha256'],'hash_actual':current_hash,'version_igual':same})
                self.evidence('sha256_shader',meta['ruta'],'Hash distinto; versión del juego '+game_version, digest=current_hash)
                if same:
                    self.mark('Shader cambió entre escaneos con misma versión del juego',meta['ruta']+'; SHA256 distinto; origen del cambio por confirmar',game=game)
            elif current_hash:
                self.evidence('sha256_shader',meta['ruta'],'Hash de shader '+game_version,digest=current_hash)
        self.data['profundo']['shaders'][game]=results
        if files:
            try:
                statepath.parent.mkdir(parents=True,exist_ok=True)
                statepath.write_text(json.dumps({'version':game_version,'archivos':[{'ruta':x['ruta'],'sha256':x.get('sha256'),'modificacion':x.get('modificacion'),'bytes':x.get('bytes')} for x in files],'utc':self.start.isoformat()},ensure_ascii=False),encoding='utf-8')
            except OSError:
                self.source('profundo_shader_linea_base_'+game, False, 'No pudo persistirse el estado')
        show('  Versión de juego para comparar shaders: '+game_version, 'muted')

    def deep_logcat(self, label):
        if label != 'antes':
            return
        ok, content, err = self.shell('logcat','-d','-b','main','-b','system','-b','events','-b','crash','-v','epoch','-t','16000',timeout=45)
        self.source('profundo_logcat_buffers',ok,err)
        if not ok:
            self.data['profundo']['logcat']={'extra':[],'cobertura':'no disponible'}
            return
        rules = {
            'wireless_adb':re.compile(r'WirelessDebuggingEnabler|ADB_WIFI_ENABLED|adb\s*wifi started|TlsServer running|persist\.adb\.tls_server\.enable',re.I),
            'hook_native':re.compile(r'libMEOW|libSLXEVE|libNGHT|frida|zygisk|lspatch|rebuild call chain|libMEOW_gift',re.I),
            'uninstall':re.compile(r'PACKAGE_REMOVED|PACKAGE_FULLY_REMOVED|deletePackage|pm uninstall|PackageManager.*(?:remove|uninstall)',re.I),
            'game_event':re.compile(r'com\.dts\.freefire(?:th|max)',re.I),
            'adb_client':re.compile(r'com\.draco\.ladb|com\.android\.system\.provider|adbd',re.I),
        }
        report=[]
        for line in content.splitlines()[-16000:]:
            tags=[name for name,rx in rules.items() if rx.search(line)]
            if not tags:
                continue
            line=redact_sensitive_line(line)
            
            stamp=re.match(r'\s*(\d{10}(?:\.\d+)?)\s+',line)
            item={'epoch':float(stamp.group(1)) if stamp else None,'tipo':tags,'texto':line[:350]}
            report.append(item)
        report = report[-750:]
        self.data['profundo']['logcat']={'extra':report,'lineas_recibidas':len(content.splitlines()),'truncado_por_limite':len(content.splitlines())>=16000}
        for item in report:
            if 'uninstall' in item['tipo']:
                self.data['profundo']['historico'].setdefault('eventos_eliminacion',[]).append(item)
            if 'hook_native' in item['tipo']:
                self.evidence('logcat','main/system/events/crash',item['texto'],timestamp=item['epoch'])
                if len(self.data['evidencias']) > 1000:
                    break
        show('  Eventos adicionales seleccionados: '+str(len(report)), 'muted')

    def deep_correlations(self):
        signals=self.data['profundo']
        pkg_audit=self.data.get('signals',{}).get('package_audit',{})
        external=self.data.get('signals',{}).get('external_watchlist',{})
        extra=signals.get('logcat',{}).get('extra',[])
        hooking=[x for x in extra if 'hook_native' in x['tipo']]
        wireless=[x for x in extra if 'wireless_adb' in x['tipo']]
        near=lambda a,b,window: any(x.get('epoch') is not None and y.get('epoch') is not None and abs(x['epoch']-y['epoch'])<=window for x in a for y in b)
        for x in signals.get('apk',[]):
            pkg=x['paquete']
            native=any(re.search(r'lib(?:meow|slxeve|nght)|frida|dobby',v,re.I) for v in x.get('nativas',[]))
            suspect=pkg in pkg_audit or pkg in external.get('present',{})
            if native and suspect and hooking:
                linked = any(pkg in e['texto'] for e in hooking)
                self.mark('APK con bibliotecas de hooking y registros nativos' ,pkg+'; APK SHA256 '+str(x.get('sha256',''))[:16]+'; eventos='+str(len(hooking)), 'CORRELACION' if linked else 'INDICIO', explanation='El log menciona el mismo paquete APK con bibliotecas nativas relacionadas con hooking; verificar el proceso cargador.' if linked else '')
        if hooking and wireless and near(hooking,wireless,600):
            gameplay = [e for e in extra if 'game_event' in e['tipo'] and e.get('epoch') is not None and e['epoch'] < self.start.timestamp() - 30]
            linked_game = bool(gameplay and (near(hooking,gameplay,3600) or near(wireless,gameplay,3600)))
            self.mark('Hooking nativo y ADB inalámbrico próximos temporalmente','eventos_hook='+str(len(hooking))+'; eventos_adb='+str(len(wireless))+'; juego_relacionado='+str(linked_game),'CORRELACION' if linked_game else 'INDICIO', explanation='Las tres categorías se observaron temporalmente cercanas; todavía es necesario demostrar relación causal y origen de la biblioteca.' if linked_game else '')
        for game in self.modes:
            for label in ('antes','despues'):
                maps=signals.get('memoria',{}).get(game+'_'+label,[])
                if any(x.get('instrumentacion') for x in maps) and hooking:
                    self.mark('Mapas del juego y logs muestran instrumentación','juego='+game+'; fase='+label+'; registro de bibliotecas nativas','CORRELACION',game,explanation='Se observaron bibliotecas vinculadas a hooking tanto en /proc/PID/maps del juego como en registros accesibles; revisar sus rutas, tiempo y legitimidad.')
        self.data['profundo']['correlaciones']=[x for x in self.findings if x.get('nivel')=='CORRELACION']

    def deep_finalize(self):
        self.data['profundo']['resumen_fuentes']={'accesibles':sum(bool(x['accesible']) for x in self.coverage.values()),'no_verificables':sum(not x['accesible'] for x in self.coverage.values())}
        self.data['profundo']['limites']=['ADB de usuario no permite leer memoria privada o archivos protegidos en todos los dispositivos','Una app o paquete histórico no confirma ejecución durante la partida','Una biblioteca dentro de APK no demuestra que fue cargada','Un hash alterado sin referencia oficial no confirma modificación maliciosa','ADB, TLS, MTP y conexiones TCP aisladas no prueban control remoto','Caracteres Unicode aleatorios o SSID inusuales no prueban corrupción de memoria','Una señal SIGSEGV/SIGABRT aislada no demuestra desbordamiento de búfer']
        self.data['profundo'].setdefault('reglas', {})['evidencias_totales'] = len(self.data['evidencias'])
        payload=json.dumps(self.data['evidencias'],ensure_ascii=False,sort_keys=True,separators=(',',':')).encode('utf-8')
        self.data['profundo']['integridad_evidencias_sha256']=hashlib.sha256(payload).hexdigest()

    def execute(self):
        self.stage_run('Identidad y seguridad Android', lambda: (self.system(), self.deep_kernel()))
        self.stage_run('Estado ADB, DNS y red', lambda: (self.adb_config(), self.deep_network()))
        self.stage_run('SSID y estado Wi-Fi del dispositivo', self.wifi_ssids)
        self.stage_run('Inventario y aplicaciones desinstaladas', lambda: (self.inventory(), self.deep_package_inventory()))
        self.stage_run('Root, módulos y frameworks', self.roots)
        self.stage_run('Hooks y procesos anteriores al reinicio', lambda: (self.process_state('antes'), self.adb_network_snapshot()))
        self.stage_run('Control remoto, accesibilidad y pantalla', self.remote_services)
        self.stage_run('Artefactos ejecutables y cargadores', self.artifacts)
        self.stage_run('Shellcode: memoria ejecutable y trazas', lambda: (self.shellcode(), self.deep_memory(self.modes[0], 'antes')))
        self.stage_run('Registro histórico de eventos', lambda: (self.logcat('antes'), self.deep_logcat('antes'), self.native_crash_audit()))
        self.stage_run('Revisión de fuentes globales', lambda: self.source('adb_device', bool(serials()), 'Dispositivo autorizado'))
        for game in self.modes:
            title = GAMES[game][0]
            self.stage_run(f'{title}: metadatos y bibliotecas', lambda g=game: (self.pkg_meta(g), self.library_timeline(g), self.deep_apk(g)))
            self.stage_run(f'{title}: shaders y caché', lambda g=game: (self.shader_scan(g), self.deep_shader(g)))
            self.stage_run(f'{title}: passador de replay y permisos W.O.', lambda g=game: self.replay_scan(g, 'antes'))
            self.stage_run(f'{title}: reinicio controlado', lambda g=game: self.game_restart(g))
            self.stage_run(f'{title}: verificación de replay posterior', lambda g=game: self.replay_scan(g, 'despues'))
            self.stage_run(f'{title}: proceso posterior al reinicio', lambda g=game: (self.shellcode(g, 'despues'), self.deep_memory(g, 'despues')))
        self.stage_run('Nueva revisión de procesos y puertos', lambda: self.process_state('despues'))
        self.stage_run('Cronología posterior y comparación histórica', lambda: (self.logcat('despues'), self.baseline()))
        self.stage_run('Correlaciones y evaluación', lambda: (self.correlate(), self.deep_correlations()))
        self.stage_run('Guardar informes', lambda: (self.deep_finalize(), self.save()))


def scan(modes):
    if not shutil.which('adb'):
        show('Falta android-tools: pkg install android-tools -y', 'alert')
        return 2
    device = adb_link()
    if not device:
        return 3
    prefix = ['adb', '-s', device, 'shell', 'getprop']
    brand, model, release = (run(prefix + [x])[1] for x in ('ro.product.brand','ro.product.model','ro.build.version.release'))
    banner(brand, model, release)
    show('Dispositivo ADB: ' + device, 'muted')
    show('La revisión es post-partida. Cierra cualquier partida antes de continuar.', 'muted')
    go = input('¿Confirmas que terminaron las partidas? [s/N]: ').strip().lower()
    if go not in ('s','si','sí'):
        show('Escaneo cancelado.', 'muted')
        return 1
    restart = input('¿Reiniciar los juegos durante el análisis? [S/n]: ').strip().lower() not in ('n','no')
    clear()
    banner(brand, model, release)
    scanner = Forense(device, modes, restart)
    try:
        run_original(scanner, modes[0])
        scanner.execute()
    except KeyboardInterrupt:
        show('\nAnálisis interrumpido; resultados parciales no implican dispositivo limpio.', 'alert')
        return 130
    except Exception as ex:
        show(f'Fallo en la etapa {scanner.stage}: {type(ex).__name__}', 'alert')
        return 4
    return 0


def session(mode):
    folder = ROOT
    folder.mkdir(parents=True, exist_ok=True)
    launched = folder/'nueva_sesion.sh'
    check = folder/'sesion_iniciada'
    check.unlink(missing_ok=True)
    engine = Path(__file__).resolve()
    launched.write_text('#!/data/data/com.termux/files/usr/bin/bash\n' + 'printf "\\033[H\\033[2J\\033[3J"\n' + f'touch {shlex.quote(str(check))}\n' + f'exec python -u {shlex.quote(str(engine))} --scan {mode}\n', encoding='utf-8')
    launched.chmod(0o700)
    if os.environ.get('PREFIX', '').startswith('/data/data/com.termux/') and shutil.which('am'):
        ok, text, err = run(['am','startservice','-n','com.termux/.app.TermuxService','-a','com.termux.service_execute','-d','file://'+str(launched),'--es','com.termux.execute.cwd',str(Path.home()),'--ez','com.termux.execute.background','false','--es','com.termux.execute.session_action','0'], 12)
        if ok:
            for _ in range(8):
                if check.exists():
                    show('Sesión dfer abierta.', 'bright')
                    return 0
                time.sleep(.25)
    clear()
    return scan(['normal','max'] if mode=='both' else [mode])


def main():
    parser = argparse.ArgumentParser(prog='dfer')
    parser.add_argument('--scan', choices=['normal','max'])
    parser.add_argument('--same-session', action='store_true')
    parser.add_argument('--verify-embedded', action='store_true')
    args = parser.parse_args()
    if args.verify_embedded:
        for mode in ('normal','max'):
            print(mode, LEGACY_SHA256[mode], len(legacy_bytes(mode)))
        return 0
    if args.scan:
        return scan([args.scan])
    while True:
        banner()
        adb_menu_status()
        show()
        show('  [1] Conectar ADB', 'bright')
        show('  [2] Free Fire', 'bright')
        show('  [3] Free Fire MAX', 'bright')
        show('  [4] Salir', 'bright')
        choice = input('\n  Selección: ').strip()
        if choice == '4':
            return 0
        if choice == '1':
            device = adb_link()
            show('  Dispositivo autorizado: ' + device if device else '  Conexión pendiente: revisa la pantalla principal de Depuración inalámbrica.', 'bright' if device else 'muted')
            input('\n  Enter para volver al menú...')
        elif choice in ('2','3'):
            mode = 'normal' if choice == '2' else 'max'
            return scan([mode]) if args.same_session else session(mode)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except EOFError:
        show('Cancelado.', 'alert')
        sys.exit(2)


