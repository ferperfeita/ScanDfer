#!/data/data/com.termux/files/usr/bin/bash
# dfer | Distribución compacta M4.1. No es cifrado ni un mecanismo antimanipulación.
set -euo pipefail
base="${HOME}/.dfer"
modulo="${base}/.dfer_m41"
biblioteca="${DFER_BIBLIOTECA:-${base}/biblioteca_referencias.json}"
mkdir -p "$base" "$modulo"
chmod 700 "$modulo" 2>/dev/null || true
if ! command -v python >/dev/null 2>&1; then
  if command -v pkg >/dev/null 2>&1; then
    printf '[dfer] Instalando Python...\n'
    pkg install python -y
  else
    printf '[dfer] Se requiere Python 3 para iniciar dfer.\n' >&2
    exit 2
  fi
fi
if ! command -v adb >/dev/null 2>&1 && [ "${1:-}" != "--verify-embedded" ] && [ "${1:-}" != "--ayuda" ] && [ "${1:-}" != "--modulos" ]; then
  if command -v pkg >/dev/null 2>&1; then
    pkg install android-tools -y || true
  fi
fi
# Los módulos internos se verifican por SHA-256 durante cada inicio.
python - "$0" "$modulo" '9790148b539b66c40dace53b873d42aa797c303aa8e49f23ce61977ea6091fa4' '' <<'PY_BOOTSTRAP'
import base64,hashlib,io,json,os,pathlib,sys,tarfile,tempfile
path,dest,expected_blob,expected_files=sys.argv[1:]
dest=pathlib.Path(dest)
with open(path,'rb') as f:
    source=f.read()
begin=b'\n__DFER_BUNDLE_BEGIN__\n'
end=b'\n__DFER_BUNDLE_END__'
if source.count(begin)!=1:
    raise SystemExit('[dfer] Paquete incompleto: falta bloque interno')
data=source.split(begin,1)[1].split(end,1)[0]
try:
    blob=base64.b64decode(data,validate=False)
except (ValueError,Exception) as ex:
    raise SystemExit('[dfer] Paquete ilegible') from ex
if hashlib.sha256(blob).hexdigest()!=expected_blob:
    raise SystemExit('[dfer] Error de integridad del paquete: distribución modificada')
manifest=json.loads(base64.b64decode(expected_files).decode('utf-8'))
with tarfile.open(fileobj=io.BytesIO(blob),mode='r:gz') as tf:
    got={}
    for item in tf.getmembers():
        if not item.isfile() or item.name not in manifest or item.name in got:
            raise SystemExit('[dfer] Paquete interno inesperado')
        payload=tf.extractfile(item).read()
        if hashlib.sha256(payload).hexdigest()!=manifest[item.name]:
            raise SystemExit('[dfer] Componente alterado')
        got[item.name]=payload
if set(got)!=set(manifest):
    raise SystemExit('[dfer] Falta un componente interno')
for name,payload in got.items():
    target=dest/name
    if target.is_symlink():
        raise SystemExit('[dfer] Ruta interna no segura')
    if target.is_file() and hashlib.sha256(target.read_bytes()).hexdigest()==manifest[name]:
        continue
    fd,fn=tempfile.mkstemp(prefix='.dfer_',dir=dest)
    try:
        with os.fdopen(fd,'wb') as f:
            f.write(payload)
        os.chmod(fn,0o700 if name.endswith('.sh') or name.endswith('.py') else 0o600)
        os.replace(fn,target)
    finally:
        if os.path.exists(fn):os.unlink(fn)
PY_BOOTSTRAP

if [ ! -f "$biblioteca" ]; then
  mkdir -p "$(dirname "$biblioteca")"
  # Nunca sobrescribir una biblioteca ya creada por el usuario.
  printf '{"referencias":[]}\n' > "$biblioteca"
  chmod 600 "$biblioteca" 2>/dev/null || true
fi

case "${1:-}" in
  --ayuda|--help)
    printf 'dfer M4.1 | Termux\n\n'
    printf '  ./dfer                 Menú original y 4 módulos post-escaneo\n'
    printf '  ./dfer --scan normal   Free Fire y 4 módulos\n'
    printf '  ./dfer --scan max      Free Fire MAX y 4 módulos\n'
    printf '  ./dfer --verify-embedded  Comprobar fuentes heredadas\n'
    printf '  ./dfer --modulos --ultimo  Reanalizar último reporte\n'
    printf '  ./dfer --modulos --registrar-referencia RUTA ...\n'
    exit 0;;
  --modulos)
    shift
    exec python -u "$modulo/dfer_modulos.py" "$@";;
esac

inicio="$(python -c 'import time; print(time.time()-2)')"
set +e
bash "$modulo/dfer_core.sh" "$@"
rc=$?
set -e
if [ "$rc" -ne 0 ]; then
  printf '[dfer] Análisis terminado con código %s. Los registros anteriores permanecen.\n' "$rc" >&2
  exit "$rc"
fi
case "${1:-}" in
  --verify-embedded|--new-session) exit 0;;
esac
# Si el usuario solo salió del menú, no hay informe nuevo y no se ejecutan módulos.
extra=(--ultimo --desde-epoch "$inicio" --referencias "$biblioteca")
if [ -n "${DFER_CLAVE_HMAC:-}" ]; then
  extra+=(--clave-hmac "$DFER_CLAVE_HMAC")
fi
# Evita mostrar fallos esperables cuando el usuario decidió salir sin escanear.
if ! python - "$inicio" <<'PY_CHECK'
import pathlib,sys
p=pathlib.Path.home()/'.dfer'/'reportes'
start=float(sys.argv[1]);good=False
if p.is_dir():
    for x in p.glob('dfer_*.json'):
        if x.is_file() and not x.name.endswith('_complemento.json') and x.stat().st_mtime>=start:
            good=True;break
sys.exit(0 if good else 1)
PY_CHECK
then
  exit 0
fi
printf '\n[dfer] Evaluando integridad, correlaciones, referencias y cobertura...\n'
if ! python -u "$modulo/dfer_modulos.py" "${extra[@]}"; then
  printf '[dfer] El módulo adicional no pudo finalizar; el informe principal permanece disponible.\n' >&2
fi
exit 0
