def run(argv, timeout=12):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, errors='replace', timeout=timeout, check=False)
        return r.returncode == 0, r.stdout.strip(), r.stderr.strip()[:250]
    except (OSError, subprocess.TimeoutExpired) as ex:
        return False, '', type(ex).__name__


def serials():
    ok, value, _ = run(['adb', 'devices'], 10)
    if not ok:
        return []
    return [t[0] for line in value.splitlines()[1:] if (t := line.split()) and len(t) >= 2 and t[1] == 'device' and re.fullmatch(r'[A-Za-z0-9:._-]+', t[0])]


