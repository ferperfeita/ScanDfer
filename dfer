def valid_endpoint(text):
    text = text.strip()
    if re.fullmatch(r'\d{1,5}', text):
        port = int(text)
        return f'127.0.0.1:{port}' if 1 <= port <= 65535 else None
    m = re.fullmatch(r'(localhost|127\.0\.0\.1|\d{1,3}(?:\.\d{1,3}){3}):(\d{1,5})', text, re.I)
    if not m or not 1 <= int(m.group(2)) <= 65535:
        return None
    host = m.group(1)
    if host.lower() not in ('localhost', '127.0.0.1') and not all(int(part) <= 255 for part in host.split('.')):
        return None
    return host + ':' + str(int(m.group(2)))


def adb_connection_candidates():
    candidates = []
    if shutil.which('getprop'):
        ok, port, _ = run(['getprop', 'service.adb.tls.port'], 6)
        if ok:
            candidate = valid_endpoint(port)
            if candidate:
                candidates.append(candidate)
    ok, output, _ = run(['adb', 'mdns', 'services'], 8)
    if ok:
        for line in output.splitlines():
            if '_adb-tls-connect._tcp' not in line:
                continue
            for found in re.findall(r'(?:localhost|127\.0\.0\.1|\d{1,3}(?:\.\d{1,3}){3}):\d{1,5}', line, re.I):
                endpoint = valid_endpoint(found)
                if endpoint and endpoint not in candidates:
                    candidates.append(endpoint)
    return candidates


def adb_autoconnect():
    if serials():
        return serials()
    for endpoint in adb_connection_candidates():
        ok, output, error = run(['adb', 'connect', endpoint], 12)
        devices = serials()
        if devices:
            show('Conexión ADB establecida: ' + devices[0], 'bright')
            return devices
    return serials()


def adb_link():
    devs = serials()
    if not devs:
        show('Buscando una conexión ADB autorizada...', 'muted')
        devs = adb_autoconnect()
    if not devs:
        show('Aún no hay conexión activa. Puedes vincular el dispositivo o usar una vinculación anterior.', 'muted')
        show('En Ajustes > Opciones de desarrollador, activa Depuración inalámbrica.')
        show('Para usar el mismo teléfono, abre Ajustes y Termux en pantalla dividida.', 'muted')
        answer = input('¿Vincular mediante código de 6 dígitos? [s/N]: ').strip().lower()
        if answer in ('s', 'si', 'sí'):
            pairing_port = input('Puerto de EMPAREJAMIENTO (ventana del código): ').strip()
            code = input('Código de 6 dígitos: ').strip()
            if pairing_port.isdigit() and 1 <= int(pairing_port) <= 65535 and re.fullmatch(r'\d{6}', code):
                ok, result, err = run(['adb', 'pair', f'127.0.0.1:{pairing_port}', code], 35)
                if ok and 'successfully paired' in result.lower():
                    show('Emparejamiento completado.', 'bright')
                    show('Buscando el puerto de CONEXIÓN ADB...', 'muted')
                    for _ in range(3):
                        devs = adb_autoconnect()
                        if devs:
                            break
                        time.sleep(.5)
                else:
                    show('No se pudo completar el emparejamiento: ' + (result or err or 'sin respuesta'), 'alert')
            else:
                show('El puerto de emparejamiento o el código no son válidos.', 'alert')
        if not devs:
            devs = adb_autoconnect()
        if not devs:
            show('Para conectar, usa el puerto de la pantalla PRINCIPAL de Depuración inalámbrica.', 'muted')
            show('Es distinto del puerto usado para emparejar.', 'muted')
            address = input('IP:PUERTO de CONEXIÓN (o solo PUERTO en este teléfono; Enter para omitir): ').strip()
            if address:
                endpoint = valid_endpoint(address)
                if endpoint:
                    ok, result, err = run(['adb', 'connect', endpoint], 20)
                    devs = serials()
                    if devs:
                        show('ADB conectado y autorizado.', 'bright')
                    else:
                        show('No se estableció la conexión: ' + (result or err or 'dispositivo no autorizado'), 'alert')
                else:
                    show('Dirección o puerto de conexión no válido.', 'alert')
    if not devs:
        show('Conexión pendiente. Abre Depuración inalámbrica y verifica su puerto de conexión.', 'muted')
        return None
    if len(devs) > 1:
        for n, dev in enumerate(devs, 1):
            show(f'[{n}] {dev}')
        choice = input('Selecciona dispositivo: ').strip()
        if not choice.isdigit() or not 1 <= int(choice) <= len(devs):
            return None
        return devs[int(choice) - 1]
    return devs[0]


