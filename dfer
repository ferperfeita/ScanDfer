    def adb_network_snapshot(self):
        ok, ps, err = self.shell('ps', '-A', timeout=18)
        self.source('adbd_process', ok, err)
        hits = [line.strip()[:260] for line in ps.splitlines()[1:] if re.search(r'(?:^|\s)(?:/system/bin/)?adbd(?:\s|$)', line)] if ok else []
        self.data['signals']['adbd_process'] = hits[:8]
        ok, output, err = self.sh('ss -tanp 2>/dev/null || ss -tan 2>/dev/null', timeout=18)
        self.source('tcp_snapshot', ok and bool(output.strip()), err)
        sockets = []
        if ok:
            for line in output.splitlines():
                tokens = line.split()
                if len(tokens) < 5 or tokens[0].upper() not in ('ESTAB','ESTABLISHED','FIN-WAIT-1','LAST-ACK','LISTEN','CLOSE-WAIT'):
                    continue
                local, peer = tokens[3:5]
                if not re.search(r':\d+$', local):
                    continue
                sockets.append({'estado':tokens[0], 'local':local, 'remoto':peer, 'proceso':' '.join(tokens[5:])[:160]})
        self.data['signals']['tcp_connections'] = sockets[:70]
        show(f'  adbd visible: {"sí" if hits else "no"}; sockets observados: {len(sockets)}')
        show('  Una conexión TCP en FIN-WAIT-1 o LAST-ACK no demuestra control remoto.', 'muted')

    def replay_fractional_audit(self, game):
        pkg = GAMES[game][1]
        dirs = [f'/sdcard/Android/data/{pkg}/files/MReplays', f'/sdcard/Android/data/{pkg}/files/mreplays']
        cmd = 'for d in ' + ' '.join(shlex.quote(x) for x in dirs) + '; do [ -d "$d" ] || continue; for p in "$d"/*.bin "$d"/*.json; do [ -f "$p" ] || continue; stat -c "%n|%y" "$p" 2>/dev/null; done; done | head -120'
        ok, raw, err = self.sh(cmd, timeout=25)
        self.source('replay_fraction_' + game, ok and bool(raw), err or 'Sin archivos legibles')
        entries = []
        for line in raw.splitlines() if ok else []:
            if '|' not in line:
                continue
            path, stamp = line.rsplit('|', 1)
            result = re.search(r'\.(\d{4,9})(?:\s|[+-]|$)', stamp)
            if result:
                digits = result.group(1)
                entries.append({'archivo':path,'tiempo':stamp,'fraccion':digits,'uniforme':len(digits)>=4 and len(set(digits))==1})
        flagged = [x for x in entries if x['uniforme']]
        self.data['games_data'][game]['replay_fractional'] = {'analizados':len(entries),'uniformes':flagged[:20]}
        if len(entries)>=5 and len(flagged)>=4 and len(flagged)/len(entries)>=0.75:
            self.mark('Marcas de tiempo subsegundo repetidas en replays', f'{len(flagged)} de {len(entries)} archivos con fracción uniforme; sin referencia del sistema de archivos', game=game)

    def shader_shell_audit(self, game, path):
        patterns = r'#!(?:/system/bin/|/bin/)?sh|(?:/system/bin/)?sh[[:space:]]+-c|su[[:space:]]+-c|setenforce[[:space:]]+0|mount[[:space:]]+-o[[:space:]]+remount|LD_PRELOAD[[:space:]]*=|pm[[:space:]]+disable-user|chmod[[:space:]]+777|/data/local/tmp/|frida-server|libMEOW_gift\.so'
        quoted = shlex.quote(path)
        cmd = ('[ -r ' + quoted + ' ] || exit 13; '
               'if command -v strings >/dev/null 2>&1; then head -c 4194304 ' + quoted + ' | strings -a -n 5; '
               'else head -c 4194304 ' + quoted + ' | tr "\\000" "\\n"; fi | '
               'grep -aEi ' + shlex.quote(patterns) + ' | head -10; exit 0')
        ok, output, err = self.sh(cmd, timeout=22)
        excerpts = [x.strip()[:170] for x in output.splitlines() if x.strip()][:10]
        self.source('shader_payload_' + game, ok, err)
        self.data['games_data'][game].setdefault('shader_strings', []).extend(excerpts)
        self.data['games_data'][game].setdefault('shader_inspecciones', []).append({'ruta': path, 'cadenas': excerpts, 'accesible': ok})
        if ok and excerpts:
            self.mark('Shader contiene cadenas compatibles con comandos de shell', f'{path}: ' + '; '.join(excerpts[:3]), game=game)
            shell_commands = any(re.search(r'#!|(?:^|\s)su\s+-c|setenforce\s+0|LD_PRELOAD|mount\s+-o\s+remount|pm\s+disable-user', x, re.I) for x in excerpts)
            if shell_commands and len(excerpts) >= 2:
                self.mark('Patrón compuesto de comandos de ejecución en archivo shader', f'{path}: ' + '; '.join(excerpts[:3]), 'CORRELACION', game, explanation='Se encontraron varias cadenas de ejecución o alteración del sistema dentro de un archivo de shaders. Requiere comparar hash contra la misma versión legítima del juego.')

