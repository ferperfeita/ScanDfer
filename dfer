#!/data/data/com.termux/files/usr/bin/bash
set -e
umask 077
mkdir -p "$HOME/.dfer"
log="$HOME/.dfer/diagnostico_inicio.log"
necesarios=()
command -v python >/dev/null 2>&1 || necesarios+=(python)
case "${1:-}" in
  --verify-embedded|--ayuda|--help|--modulos) ;;
  *) command -v adb >/dev/null 2>&1 || necesarios+=(android-tools) ;;
esac
if [ "${#necesarios[@]}" -gt 0 ]; then
  if ! command -v pkg >/dev/null 2>&1 || ! pkg install -y "${necesarios[@]}" </dev/null >> "$log" 2>&1; then
    printf 'dfer no pudo preparar su entorno. Revisa ~/.dfer/diagnostico_inicio.log
' >&2
    exit 2
  fi
fi
python -u - "$0" "$@" <<'DFER_INICIAR'
