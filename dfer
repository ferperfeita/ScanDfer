    def native_crash_audit(self):
        ok, content, err = self.shell('logcat', '-d', '-b', 'crash', '-b', 'main', '-b', 'system', '-v', 'epoch', '-t', '10000', timeout=35)
        self.source('memoria_logcat_crash', ok, err)
        result = {'accesible':ok, 'fallos_confirmados_por_log':[], 'fallos_no_especificos':[], 'unicode_sin_fallo':0, 'limitaciones': 'El registro de errores no permite inspeccionar todos los bytes de RAM ni reconstruir un desbordamiento.'}
        if not ok:
            self.data['profundo']['fallos_nativos'] = result
            return
        lines = content.splitlines()[-10000:]
        corrupt = re.compile(r'FORTIFY:|stack smashing detected|stack canary|(?:heap|stack)[-_ ]buffer[-_ ]overflow|Scudo ERROR|AddressSanitizer|HWAddressSanitizer|MTE tag check fault|double free or corruption|heap corruption|heap[- ]use[- ]after[- ]free|invalid (?:free|pointer)', re.I)
        crash = re.compile(r'Fatal signal\s+(?:6|11)|SIGSEGV|SIGABRT|tombstone written|crash_dump(?:32|64)|backtrace:', re.I)
        hook = re.compile(r'libMEOW|libSLXEVE|libNGHT|frida|dobby|zygisk|lspatch|rebuild call chain', re.I)
        game_ids = [GAMES[g][1] for g in self.modes]
        patterns = []
        for i, line in enumerate(lines):
            severe = bool(corrupt.search(line))
            generic = bool(crash.search(line))
            if not (severe or generic):
                if '땷村弐ၡ㐺㠺昵㩥㠺' in line:
                    result['unicode_sin_fallo'] += 1
                continue
            before = lines[max(i-12,0):i+1]
            stamp = re.match(r'\s*(\d{10}(?:\.\d+)?)\s+',line)
            timestamp = float(stamp.group(1)) if stamp else None
            nearby = []
            if timestamp is not None:
                for candidate in before:
                    observed = re.match(r'\s*(\d{10}(?:\.\d+)?)\s+', candidate)
                    if observed and 0 <= timestamp - float(observed.group(1)) <= 120:
                        nearby.append(candidate)
            context = '\n'.join(nearby)
            package = next((p for p in game_ids if p in context), None)
            redacted = redact_sensitive_line(line)[:300]
            event = {'fecha_epoch': timestamp, 'clase': 'indicador_especifico' if severe else 'fallo_nativo_no_especifico', 'juego_en_contexto': package, 'registro': redacted, 'hook_cercano': any(hook.search(x) for x in nearby)}
            key = 'fallos_confirmados_por_log' if severe else 'fallos_no_especificos'
            if len(result[key]) < 35:
                result[key].append(event)
            if severe and package and len(patterns) < 15:
                patterns.append(event)
        self.data['profundo']['fallos_nativos'] = result
        show(f'  Registros específicos de error de memoria: {len(result["fallos_confirmados_por_log"])}', 'muted')
        show(f'  Otros indicios de fallo nativo: {len(result["fallos_no_especificos"])}', 'muted')
        for event in patterns[:5]:
            self.evidence('logcat_memoria_nativa','logcat -b crash/main/system',event['registro'],timestamp=event['fecha_epoch'])
            if event['hook_cercano']:
                self.mark('Error específico de memoria y hooking próximos en logs',event['registro'],'CORRELACION',explanation='El log registra un fallo compatible con corrupción de memoria y una referencia de hooking en el contexto. Esto no prueba por sí mismo que un cheat haya causado el fallo.')
            else:
                self.mark('Registro de posible corrupción de memoria en contexto del juego',event['registro'],'INDICIO')
        if result['unicode_sin_fallo']:
            show('  Texto Unicode atípico observado; no se clasifica como desbordamiento sin señales de fallo.', 'muted')

