    def evidence(self, source, path, excerpt, timestamp=None, digest=None, accessible=True):
        item = {'id': 'E' + str(len(self.data['evidencias']) + 1).zfill(4), 'fuente': source, 'ruta': str(path)[:400], 'extracto': str(excerpt)[:440], 'fecha_utc': timestamp, 'sha256': digest, 'accesible': bool(accessible)}
        self.data['evidencias'].append(item)
        return item['id']

    def deep_kernel(self):
        report = {'props': {}, 'mounts_juego': [], 'modulos_visibles': [], 'selinux': None}
        for prop in ('ro.boot.verifiedbootstate', 'ro.boot.vbmeta.device_state', 'ro.boot.flash.locked', 'ro.boot.selinux', 'ro.kernel.qemu', 'ro.build.type', 'ro.build.tags', 'ro.secure', 'ro.debuggable', 'service.adb.root'):
            report['props'][prop] = self.getprop(prop)
        ok, enforce, err = self.shell('getenforce')
        report['selinux'] = enforce if ok else None
        self.source('profundo_selinux', ok, err)
        ok, mounts, err = self.sh('cat /proc/mounts 2>/dev/null', 20)
        self.source('profundo_mounts', ok, err)
        if ok:
            pkgs = [GAMES[g][1] for g in self.modes]
            report['mounts_juego'] = [line[:360] for line in mounts.splitlines() if any(pkg in line for pkg in pkgs)][:30]
            for line in report['mounts_juego']:
                self.evidence('proc/mounts', '/proc/mounts', line)
            if report['mounts_juego']:
                self.mark('Montajes específicos relacionados con directorios del juego', 'líneas=' + str(len(report['mounts_juego'])) + '; revisar namespace y origen antes de inferir overlay')
        ok, modules, err = self.sh('cat /proc/modules 2>/dev/null', 18)
        self.source('profundo_kernel_modulos', ok, err or 'Sin permisos para listar módulos')
        if ok:
            report['modulos_visibles'] = [line.split()[0] for line in modules.splitlines() if line.split()][:120]
            suspect = [x for x in report['modulos_visibles'] if re.search(r'apatch|magisk|kernelsu|zygisk|frida|hide|hook', x, re.I)]
            if suspect:
                self.mark('Módulo de kernel con identificador relevante', ', '.join(suspect[:8]))
                self.evidence('proc/modules', '/proc/modules', ', '.join(suspect[:8]))
        self.data['profundo']['kernel'] = report

    def deep_network(self):
        report = {'adb': {}, 'sockets': [], 'vpn': [], 'proxy': None, 'fuentes': []}
        for key in ('persist.adb.tls_server.enable', 'service.adb.tls.port', 'service.adb.tcp.port', 'persist.adb.tcp.port', 'sys.usb.state'):
            report['adb'][key] = self.getprop(key)
        ok, sockets, err = self.sh('ss -tunap 2>/dev/null || ss -tun 2>/dev/null', 22)
        self.source('profundo_sockets', ok, err)
        if ok:
            for line in sockets.splitlines()[1:]:
                fields = line.split()
                if len(fields) < 5:
                    continue
                state, local, peer = fields[1] if fields[0] in ('tcp','udp','tcp6','udp6') and len(fields)>1 else fields[0], fields[4] if fields[0] in ('tcp','udp','tcp6','udp6') and len(fields)>4 else fields[3], fields[5] if fields[0] in ('tcp','udp','tcp6','udp6') and len(fields)>5 else fields[4]
                if any(x in state for x in ('ESTAB','LISTEN','FIN-WAIT','LAST-ACK','CLOSE-WAIT')):
                    report['sockets'].append({'estado':state, 'local':local[:90], 'remoto':peer[:90], 'proceso': ' '.join(fields[6:])[:120]})
                if len(report['sockets']) >= 100:
                    break
        ok, interfaces, err = self.sh('ip -o link show 2>/dev/null || cat /proc/net/dev 2>/dev/null', 15)
        self.source('profundo_interfaces', ok, err)
        if ok:
            report['vpn'] = [line[:180] for line in interfaces.splitlines() if re.search(r'\b(?:tun|tap|wg|ppp|ipsec)\d*\b', line, re.I)][:12]
        report['proxy'] = self.data.get('settings',{}).get('global:http_proxy')
        self.data['profundo']['red'] = report
        if report['vpn']:
            self.mark('Interfaz de túnel VPN observada', ', '.join(report['vpn'][:2]))
        show('  Conexiones TLS, IP privadas y MTP no constituyen prueba de control remoto.', 'muted')

