    def audit_special_packages(self):
        packages = set(self.data.get('installed_packages', []))
        current = set(self.data.get('current_packages', []))
        accessibility = set(self.data.get('accessibility', []))
        candidates = set()
        for pkg in packages:
            disguise = bool(re.search(r'^(?:com\.android\.system(?:\.|$)|com\.android\.provider(?:\.|$)|com\.android\.security(?:\.|$))', pkg, re.I))
            if disguise or HOOK.search(pkg) or REMOTE.search(pkg) or PAYLOAD.search(pkg) or pkg == 'com.draco.ladb':
                candidates.add(pkg)
        candidates |= (packages & accessibility)
        candidates |= (current & {'com.android.system.provider', 'com.draco.ladb'})
        items = {}
        for package in sorted(candidates)[:28]:
            ok, dump, err = self.shell('dumpsys', 'package', package, timeout=15)
            self.source('audit_' + package, ok, err)
            path_ok, raw_paths, path_err = self.shell('pm', 'path', package)
            self.source('package_path_' + package, path_ok, path_err)
            paths = re.findall(r'^package:(.+)$', raw_paths, re.M) if path_ok else []
            activities = sorted(set(re.findall(r'[\w.$]*(?:InjectionActivity|BypassActivity|AdbActivity)[\w.$]*', dump, re.I)))[:20] if ok else []
            perms = sorted(set(re.findall(r'android\.permission\.[A-Z_]+', dump)))[:50] if ok else []
            libs = sorted(set(re.findall(r'lib(?:SLXEVE|NGHT|MEOW(?:_gift)?)\.so', dump, re.I)))[:12] if ok else []
            installer = re.search(r'installerPackageName=([^\s]+)', dump) if ok else None
            disguise = bool(re.search(r'^com\.android\.(?:system|provider|security)(?:\.|$)', package, re.I))
            userdata = any(v.startswith(('/data/app/', '/mnt/expand/')) for v in paths)
            enabled_access = package in accessibility
            risk = ['nombre_de_sistema_en_app_de_usuario'] if disguise and userdata else []
            if activities:
                risk.append('actividades_de_inyeccion_o_adb')
            if libs:
                risk.append('bibliotecas_especificas_en_metadatos')
            if enabled_access:
                risk.append('accesibilidad_activa')
            info = {'paquete':package,'ruta': paths[:8], 'instalador':installer.group(1) if installer else None,'actividades':activities,'permisos':perms,'bibliotecas':libs,'accesibilidad':enabled_access,'señales':risk}
            items[package] = info
            if package == 'com.draco.ladb':
                self.mark('Aplicación LADB identificada', package)
            if disguise and userdata:
                self.mark('App instalada con identidad semejante a componente Android', package + ': ' + ', '.join(paths[:2]), 'INDICIO')
            if disguise and userdata and activities:
                self.mark('Identidad de sistema y componentes de inyección en una app de usuario', package + ': ' + ', '.join(activities), 'CORRELACION', explanation='El nombre sugiere un componente Android, pero el APK está instalado como aplicación de usuario y declara actividades relacionadas con inyección/ADB. Confirmar firma y contenido del APK.')
            if enabled_access and (REMOTE.search(package) or disguise):
                self.mark('App candidata con accesibilidad habilitada', package)
        self.data['signals']['package_audit'] = items
        show(f'  Aplicaciones candidatas examinadas: {len(items)}')
        show('  Permisos comunes como INTERNET/MTP no implican trampas.', 'muted')

