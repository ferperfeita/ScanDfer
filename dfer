                    hits.append(line.strip()[:250])
            for line in hits[:20]:
                self.mark('Proceso de instrumentación/control', line)
        ok_s, sockets, err_s = self.sh('ss -ltn 2>/dev/null || cat /proc/net/tcp /proc/net/tcp6 2>/dev/null', 16)
        self.source('ports_' + label, ok_s, err_s)
        suspicious = []
        for port, regex in ((27042, r':27042\b|:69A2\b'), (27043,r':27043\b|:69A3\b'),(5555,r':5555\b|:15B3\b')):
            if re.search(regex, sockets, re.I):
