            package = GAMES[game][1]
            ok_pid, pids, _ = self.shell('pidof', package)
            result = {'pids': pids.split(), 'maps': [], 'tracers': []}
            for pid in pids.split()[:3] if ok_pid else []:
                if not pid.isdigit():
                    continue
                ok, maps, err = self.sh(f'cat /proc/{pid}/maps', 12)
                self.source(f'maps_{game}_{pid}', ok, err)
                if ok:
                    for line in maps.splitlines():
                        pieces = line.split()
                        rwx = len(pieces) >= 2 and pieces[1].startswith('rwx')
                        anomaly = rwx or '(deleted)' in line or 'memfd:' in line or ' /data/local/tmp/' in line
                        if anomaly:
                            result['maps'].append(line[:250])
                            if len(result['maps']) <= 6:
                                self.mark('Mapa ejecutable anómalo o efímero', line[:140], game=game)
                ok_s, status, err_s = self.sh(f'cat /proc/{pid}/status')
                self.source(f'procstatus_{game}_{pid}', ok_s, err_s)
                tracer = re.search(r'^TracerPid:\s*(\d+)', status, re.M) if ok_s else None
                if tracer and tracer.group(1) != '0':
                    result['tracers'].append(tracer.group(1))
                    self.mark('Proceso del juego trazado por debugger', f'{package} PID {pid} TracerPid {tracer.group(1)}', 'CORRELACION', game)
            report[game] = result
        self.data.setdefault('shellcode_indicators', {})[label] = report
        show('  Se revisaron mapeos y rastros visibles; no se leen bytes de memoria privada.', 'muted')

    def pkg_meta(self, game):
