    def library_timeline(self, game):
        package = GAMES[game][1]
        ok, metadata, err = self.shell('dumpsys', 'package', package, timeout=18)
        self.source('library_metadata_' + game, ok, err)
        if not ok:
            return
        libpath = re.search(r'nativeLibraryDir=([^\s]+)', metadata)
        install = self.data['games_data'].get(game, {}).get('first_install') or ''
        if not libpath or not install:
            self.source('native_libs_' + game, False, 'Sin ruta de bibliotecas o fecha de instalación')
            return
        directory = libpath.group(1)
        if not (directory.startswith('/data/app/') or directory.startswith('/mnt/expand/')):
            self.source('native_libs_' + game, False, 'Directorio no esperado')
            return
        command = 'base=$(date -d ' + shlex.quote(install) + ' +%s 2>/dev/null) || exit 1; [ -n "$base" ] || exit 1; find ' + shlex.quote(directory) + ' -maxdepth 3 -type f -name "*.so" 2>/dev/null | head -30 | while IFS= read -r p; do t=$(stat -c %Y "$p" 2>/dev/null); [ -n "$t" ] && [ "$t" -gt "$base" ] && echo "$p|$t|$base"; done'
        ok, output, err = self.sh(command, 18)
        self.source('native_libs_' + game, ok, err)
        if ok:
            for entry in output.splitlines()[:12]:
                self.mark('Biblioteca nativa más reciente que instalación del juego', entry, game=game, wo=True)

    def file_metadata(self, remote_path):
        cmd = 'stat -c "%n|%s|%a|%U|%G|%X|%Y|%Z" ' + shlex.quote(remote_path) + ' 2>/dev/null'
        ok, output, err = self.sh(cmd, 13)
        parts = output.strip().split('|') if ok else []
        if len(parts) != 8:
            return None
        obj = {'ruta': parts[0], 'bytes': parts[1], 'permisos': parts[2], 'usuario': parts[3], 'grupo': parts[4], 'acceso': parts[5], 'modificacion': parts[6], 'cambio': parts[7]}
        if parts[1].isdigit() and int(parts[1]) <= 10 * 1024 * 1024:
            good, digest, _ = self.sh('sha256sum ' + shlex.quote(remote_path) + ' 2>/dev/null', 15)
            if good and re.fullmatch(r'[a-fA-F0-9]{64}', digest.split(' ')[0]):
                obj['sha256'] = digest.split(' ')[0].lower()
        return obj

    def replay_scan(self, game, label):
        pkg = GAMES[game][1]
        result = {'fase': label, 'archivos': [], 'shader': None, 'comparaciones': []}
        targets = (f'/sdcard/Android/data/{pkg}/files/MReplays', f'/sdcard/Android/data/{pkg}/files/mreplays')
        seen = set()
        for directory in targets:
            ok, names, err = self.sh('ls -1t ' + shlex.quote(directory) + ' 2>/dev/null | head -20', 14)
            if ok:
                self.source(f'replays_{game}_{label}_{len(seen)}', True)
            if not ok or not names:
                continue
            for name in names.splitlines():
                if not name.lower().endswith(('.bin', '.json')) or '/' in name or name in ('.','..'):
                    continue
                remote_path = directory + '/' + name
                if remote_path in seen:
                    continue
                seen.add(remote_path)
                meta = self.file_metadata(remote_path)
                if meta:
                    if any(x['ruta'].lower().endswith('.bin') for x in result['archivos']) and name.lower().endswith('.bin'):
                        continue
                    if any(x['ruta'].lower().endswith('.json') for x in result['archivos']) and name.lower().endswith('.json'):
                        continue
                    result['archivos'].append(meta)
                    if meta['permisos'] not in ('660','0660'):
                        self.mark('Replay: permisos distintos de 0660', f'{remote_path}: {meta["permisos"]}', game=game, wo=True)
                    if 'shell' in (meta['usuario'].lower(), meta['grupo'].lower()):
                        self.mark('Replay: propietario o grupo shell', remote_path, game=game, wo=True)
                if len(result['archivos']) >= 12:
                    break
            if result['archivos']:
                break
        if not result['archivos']:
            self.source(f'replays_{game}_{label}', False, 'Sin ficheros visibles o directorio protegido')
        bin_files = [x for x in result['archivos'] if x['ruta'].lower().endswith('.bin')]
        json_files = [x for x in result['archivos'] if x['ruta'].lower().endswith('.json')]
        if bin_files and json_files:
            b, j = bin_files[0], json_files[0]
            stamps = [b[k] for k in ('acceso','modificacion','cambio')] + [j[k] for k in ('acceso','modificacion','cambio')]
            if all(x.isdigit() for x in stamps) and len(set(stamps)) == 1:
                self.mark('Replay: seis marcas temporales idénticas', f'{b["ruta"]} + {j["ruta"]}', game=game, wo=True)
        self.data['games_data'][game].setdefault('replays', {})[label] = result
        if label == 'antes':
            self.replay_fractional_audit(game)
        show(f'  Replays inspeccionados: {len(result["archivos"])}')
        return result

    def shader_scan(self, game):
        pkg, expected = GAMES[game][1], GAMES[game][2]
        directory = f'/sdcard/Android/data/{pkg}/files/contentcache/Optional/android/gameassetbundles'
        ok, names, err = self.sh('ls -1 ' + shlex.quote(directory) + ' 2>/dev/null | head -90', 18)
        self.source('shader_directory_' + game, ok and bool(names), err or 'No visible')
        files = []
        if ok:
            candidates = [name for name in names.splitlines() if name.startswith('shaders.') and '/' not in name][:6]
            for name in candidates:
                meta = self.file_metadata(directory + '/' + name)
                if meta:
                    files.append(meta)
        self.data['games_data'][game]['shaders'] = files
        self.data['games_data'][game]['shader'] = files[0] if files else {}
        if not files:
            show('  Shaders no visibles desde ADB.', 'muted')
            return
        show(f'  Shaders revisados: {len(files)}')
        for meta in files:
            show(f'  {Path(meta["ruta"]).name}: {meta["bytes"]} bytes')
            if meta is files[0] and meta['bytes'].isdigit() and int(meta['bytes']) != expected:
                self.mark('Tamaño del shader principal diferente a referencia histórica', f'{meta["bytes"]} vs {expected}; esta referencia puede variar según actualización', game=game)
            self.shader_shell_audit(game, meta['ruta'])

    def logcat(self, label):
        ok, logs, err = self.shell('logcat', '-d', '-v', 'epoch', '-t', '5500', timeout=28)
        self.source('logcat_' + label, ok, err)
        categories = (
            ('adb_wifi_on', r'ADB_WIFI_ENABLED\s*[=:]\s*true|persist\.adb\.tls_server\.enable changed to 1'),
            ('adb_wifi_off', r'ADB_WIFI_ENABLED\s*[=:]\s*false|persist\.adb\.tls_server\.enable changed to 0|adb wifi stopped'),
            ('adb_tls_started', r'adbwifi started on port|TlsServer running on port|adb wifi started on port'),
            ('adb_tls_port', r'Sending TLS port to framework|service\.adb\.tls\.port'),
            ('ladb_activity', r'com\.draco\.ladb'),
            ('provider_lib', r'libSLXEVE\.so|libNGHT\.so'),
            ('provider_adb_probe', r'AdbManager\.isAdbConnected'),
            ('provider_activity', r'com\.android\.system\.provider\.(?:InjectionActivity|BypassActivity|AdbActivity)'),
            ('provider_process', r'com\.android\.system\.provider'),
            ('meow_applied', r'libMEOW\s*:?\s*applied\s+\d+\s+plugins?\s+for\s*\['),
            ('meow_plugin', r'libMEOW_gift\.so|plugin\s+\d+\s*:\s*\[libMEOW'),
            ('meow_chain', r'libMEOW\s*:?\s*rebuild call chain'),
            ('uninstall', r'PACKAGE_REMOVED|package removed|removing package|pm uninstall'),
            ('access_marker', r'KEY_ACCESS_CHANGED'),
            ('watch_local', r'u0_a(?:576|331|680)@localhost|(?<![A-Za-z0-9_.])(?:MTH|TNTADB)(?![A-Za-z0-9_.])'),
        )
        events = []
        hits = []
        if ok:
            for line in logs.splitlines():
                kinds = [name for name, regex in categories if re.search(regex, line, re.I)]
                relevant = kinds or HOOK.search(line) or re.search(r'com\.dts\.freefire.*(?:crash|fatal|signal|start|force|kill|anr|load)',line,re.I)
                if relevant:
                    hits.append(line.strip()[:450])
                stamp = re.match(r'\s*(\d{10}(?:\.\d+)?)\s+', line)
                epoch = float(stamp.group(1)) if stamp else None
                for kind in kinds:
                    events.append({'tipo':kind,'epoch':epoch,'registro':line.strip()[:450]})
            show(f'  Registros correlacionables: {len(hits)}')
        self.data['snapshots']['logcat_' + label] = hits[-130:]
        self.data['signals']['logcat_events_' + label] = events[-220:]
        ok_b, size, err_b = self.shell('logcat', '-g', timeout=12)
        if ok_b:
            self.data['signals']['log_buffers'] = size[:600]
            if re.search(r'(?:main|system):[^\n]*(?:64\s*KiB|64\s*KB|65536\s*bytes)', size, re.I):
                self.data['signals']['logcat_historial_limitado'] = True
                show('  Historial logcat limitado por buffer pequeño; los eventos antiguos pueden faltar.', 'muted')
        else:
            self.source('logcat_buffers', False, err_b)

    def game_restart(self, game):
        pkg = GAMES[game][1]
        if not self.data['games_data'][game]['installed']:
            show('  Juego no instalado: reinicio omitido.', 'muted')
            self.source('restart_' + game, False, 'Juego no instalado')
            return
        if not self.do_restart:
            show('  Reinicio omitido por decisión del usuario.', 'muted')
            return
        stopped, stop_message, stop_err = self.shell('am', 'force-stop', pkg)
        self.source('stop_' + game, stopped, stop_err or stop_message)
        if not stopped:
            self.data['games_data'][game]['restart'] = {'launched': False, 'error': stop_err or stop_message}
            return
        ok, result, err = self.shell('monkey', '-p', pkg, '-c', 'android.intent.category.LAUNCHER', '1', timeout=20)
        self.source('restart_' + game, ok and 'Events injected' in result, err or result[-80:])
        if ok:
            show('  Inicio del juego solicitado. Capturando estado...')
            time.sleep(3)
            _, pids, _ = self.shell('pidof', pkg)
            self.data['games_data'][game]['restart'] = {'launched': True, 'pid': pids, 'at': datetime.datetime.now(datetime.timezone.utc).isoformat()}
            show(f'  PID tras reinicio: {pids or "no observado"}')
            self.shell('input', 'keyevent', 'KEYCODE_HOME')
            self.shell('monkey', '-p', 'com.termux', '-c', 'android.intent.category.LAUNCHER', '1', timeout=14)
        else:
            self.data['games_data'][game]['restart'] = {'launched': False, 'error': err or result[-180:]}

    def correlate(self):
        before = self.data['snapshots'].get('antes') or {}
        after = self.data['snapshots'].get('despues') or {}
        hooks = before.get('process_hits',[]) or after.get('process_hits',[])
        ports = set(before.get('ports',[])+after.get('ports',[]))
        if hooks and {27042,27043}.intersection(ports):
            self.mark('Proceso de instrumentación junto a puerto compatible', f'Procesos: {len(hooks)}; puertos: {sorted(ports)}', 'CORRELACION')
        memory_before = self.data.get('shellcode_indicators', {}).get('antes', {})
        memory_after = self.data.get('shellcode_indicators', {}).get('despues', {})
        for game in self.modes:
            prev = memory_before.get(game, {})
            post = memory_after.get(game, {})
            before_marks = set(prev.get('maps', []))
            after_marks = set(post.get('maps', []))
            if post.get('tracers') and not prev.get('tracers'):
                self.mark('Debugger observado tras reinicio del juego', ', '.join(post['tracers']), 'CORRELACION', game)
            if before_marks and after_marks and before_marks != after_marks:
                self.mark('Cambios en mapas ejecutables antes y después del reinicio', f'antes={len(before_marks)} después={len(after_marks)}', game=game)
        if self.data.get('remote_accessibility') and self.data.get('media_projection_hint'):
            self.mark('Control remoto, accesibilidad y proyección coexistentes', ', '.join(self.data['remote_accessibility']), 'CORRELACION')
        for game in self.modes:
            game_data = self.data['games_data'].get(game, {})
            rep = game_data.get('replays', {})
            a = rep.get('antes', {}).get('archivos', [])
            b = rep.get('despues', {}).get('archivos', [])
            pre = {x['ruta']: x for x in a}
            post = {x['ruta']: x for x in b}
            changed = [p for p in pre.keys() & post.keys() if pre[p].get('modificacion') != post[p].get('modificacion') or pre[p].get('bytes') != post[p].get('bytes')]
            if changed:
                self.mark('Replay modificado alrededor del reinicio del juego', ', '.join(changed[:3]), game=game)
            shader = game_data.get('shader') or {}
            if shader and a:
                try:
                    last = max(int(x['modificacion']) for x in a if x['modificacion'].isdigit())
                    sh_ts = int(shader['modificacion'])
                    if sh_ts >= last and abs(sh_ts-last) <= 1800:
                        self.mark('Shader y replay con modificaciones temporalmente próximas', f'Delta {sh_ts-last}s', 'INDICIO', game)
                except (ValueError, TypeError, KeyError):
                    pass
        state = self.data.get('signals', {})
        audit = state.get('package_audit', {})
        events = state.get('logcat_events_antes', []) + state.get('logcat_events_despues', [])
        events = list({(e['tipo'], e['registro']): e for e in events}.values())
        groups = {}
        for item in events:
            groups.setdefault(item['tipo'], []).append(item)
        def nearby(left, right, seconds=600):
            return any(a.get('epoch') is not None and b.get('epoch') is not None and abs(a['epoch'] - b['epoch']) <= seconds for a in left for b in right)
        wireless = groups.get('adb_wifi_on',[]) + groups.get('adb_tls_started',[])
        replay_epochs = []
        for g in self.modes:
            tracks = self.data['games_data'].get(g,{}).get('replays',{}).get('antes',{}).get('archivos',[])
            replay_epochs.extend(int(x['modificacion']) for x in tracks if str(x.get('modificacion','')).isdigit())
        def near_match(items, seconds=5400):
            return any(e.get('epoch') is not None and e['epoch'] < self.start.timestamp() - 30 and abs(e['epoch'] - t) <= seconds for e in items for t in replay_epochs)
        ladb = audit.get('com.draco.ladb')
        ladb_events = groups.get('ladb_activity',[])
        if ladb and wireless:
            if ladb_events and nearby(ladb_events, wireless) and near_match(wireless):
                self.mark('LADB y activación ADB Wi-Fi próximos en el tiempo', f'LADB instalado; eventos de app={len(ladb_events)}; ADB Wi-Fi={len(wireless)}; adbd={bool(state.get("adbd_process"))}', 'CORRELACION', explanation='El uso observado de LADB coincide temporalmente con el inicio de ADB inalámbrico. No demuestra ejecución de un cheat; revisar las acciones y el horario de la partida.')
            else:
                self.mark('LADB instalado y actividad histórica de ADB Wi-Fi', 'Presencia y actividad inalámbrica sin relación temporal verificable con una partida; ADB usado por el propio scanner')
        provider = audit.get('com.android.system.provider')
        libs = groups.get('provider_lib',[])
        probes = groups.get('provider_adb_probe',[])
        provider_activity = groups.get('provider_activity',[])
        if provider and libs:
            related = [e for e in libs if re.search(r'com\.android\.system\.provider|lib(?:SLXEVE|NGHT)\.so',e.get('registro',''),re.I)]
            if related and (provider.get('actividades') or provider_activity):
                self.mark('App de apariencia Android con bibliotecas y actividades de inyección', 'com.android.system.provider; bibliotecas observadas en logs; actividades=' + ','.join(provider.get('actividades',[])[:4]), 'CORRELACION', explanation='Se relacionan un paquete instalado como app de usuario, actividades de inyección/ADB y bibliotecas nativas inusuales. Exige inspeccionar firma y APK; los nombres por sí solos no prueban inyección.')
            if related and probes and wireless and nearby(related, wireless, 900) and near_match(wireless):
                self.mark('Bibliotecas de app camuflada y ADB Wi-Fi cerca en el tiempo', f'bibliotecas={len(related)}; consultas_ADB={len(probes)}; wifi={len(wireless)}', 'CORRELACION', explanation='Los registros sitúan bibliotecas nativas y activación de ADB inalámbrico en una ventana de 15 minutos. Debe confirmarse la atribución al proceso y la relación con la partida.')
        applied = groups.get('meow_applied',[])
        plugins = groups.get('meow_plugin',[])
        chains = groups.get('meow_chain',[])
        targets = set()
        for e in applied:
            m = re.search(r'for\s*\[([^\]]+)\]',e['registro'],re.I)
            if m:
                targets.add(m.group(1))
        if applied and plugins and nearby(applied,plugins,120):
            severe = len(targets)>=2 and bool(chains) and nearby(applied,chains,120)
            self.mark('libMEOW con plugins aplicados a procesos', f'procesos={", ".join(sorted(targets)[:7]) or "sin identificar"}; plugin=libMEOW_gift.so; call_chain={bool(chains)}', 'CORRELACION' if severe else 'INDICIO', explanation='Logcat documenta carga de plugins nativos y reconstrucción de llamadas en varios procesos. Es evidencia de hooking a nivel de usuario, no de parcheo del kernel.' if severe else '')
        removals = groups.get('uninstall',[])
        if removals:
            self.mark('Eventos históricos de desinstalación visibles', f'eventos={len(removals)}; fecha y paquete deben comprobarse')
        if groups.get('access_marker'):
            self.mark('Referencia a marcador de control de acceso', 'KEY_ACCESS_CHANGED; no se infiere uso ni se guarda una clave')
        for game in self.modes:
            gd = self.data['games_data'].get(game,{})
            inspections = gd.get('shader_inspecciones',[])
            rep = gd.get('replays',{}).get('antes',{}).get('archivos',[])
            known = {x['ruta']:x for x in gd.get('shaders',[]) if x.get('ruta')}
            if not known and gd.get('shader',{}).get('ruta'):
                known[gd['shader']['ruta']] = gd['shader']
            for entry in inspections:
                shader = known.get(entry['ruta'],{})
                if not entry.get('cadenas') or not rep or not str(shader.get('modificacion','')).isdigit():
                    continue
                stamps = [int(x['modificacion']) for x in rep if str(x.get('modificacion','')).isdigit()]
                if stamps and min(abs(int(shader['modificacion'])-v) for v in stamps)<=1800:
                    self.mark('Shader con cadenas shell y modificación próxima a replay', f'{entry["ruta"]}; {len(entry["cadenas"])} cadenas; delta <30 min', 'CORRELACION', game, explanation='Se relacionan cadenas de shell en el archivo shader y metadatos temporales de un replay. Comparar hash contra una versión oficial antes de concluir alteración.')
        self.watchlist_log_history()
        self.watchlist_correlations()
        show('  El estado actual de ADB forma parte del propio procedimiento de revisión.', 'muted')
        show('  MTP, ro.adb.secure=1 o sockets TLS aislados no son prueba de acceso externo.', 'muted')
        if any(x['nivel']=='CORRELACION' for x in self.findings):
            show('  Existen correlaciones que requieren examen de evidencias.', 'alert')
        else:
            show('  Sin correlaciones fuertes en las fuentes disponibles.', 'muted')

    def baseline(self):
        statefile = ROOT / (hashlib.sha256(self.device.encode()).hexdigest()[:16] + '.json')
        previous = {}
        try:
            previous = json.loads(statefile.read_text(encoding='utf-8'))
        except (OSError, ValueError):
            pass
        current = {'utc': self.start.isoformat(), 'installed_packages': self.data.get('installed_packages', []), 'current_packages': self.data.get('current_packages', []), 'accessibility': self.data.get('accessibility', []), 'known_not_current': self.data.get('packages_known_not_current', []), 'watch_paths': {k: v.get('rutas', []) for k, v in self.data.get('signals', {}).get('external_watchlist', {}).get('present', {}).items()}}
        self.watchlist_snapshot(previous, current)
        if previous and self.coverage.get('installed_packages', {}).get('accesible'):
            removed = sorted(set(previous.get('installed_packages', [])) - set(current['installed_packages']))
            added = sorted(set(current['installed_packages']) - set(previous.get('installed_packages', [])))
            self.data['diff'] = {'removed': removed, 'added': added}
            for pkg in removed:
                if HOOK.search(pkg) or REMOTE.search(pkg) or PAYLOAD.search(pkg):
                    self.mark('Herramienta ausente desde escaneo anterior', pkg)
            show(f'  Paquetes retirados desde última muestra: {len(removed)}')
        else:
            show('  Sin línea base anterior verificable.', 'muted')
        if self.coverage.get('installed_packages', {}).get('accesible') and self.coverage.get('known_packages', {}).get('accesible'):
            ROOT.mkdir(parents=True, exist_ok=True)
            statefile.write_text(json.dumps(current, ensure_ascii=False), encoding='utf-8')

    def save(self):
        REPORTS.mkdir(parents=True, exist_ok=True)
        self.data['hallazgos'] = self.findings
        self.data['alertas_wo'] = self.wo
        self.data['cobertura'] = self.coverage
