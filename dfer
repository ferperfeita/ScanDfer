def legacy_bytes(mode):
    raw = zlib.decompress(base64.b64decode(''.join(LEGACY_PAYLOADS[mode])))
    if hashlib.sha256(raw).hexdigest() != LEGACY_SHA256[mode]:
        raise ValueError('La integridad del script original no coincide')
    pkg = GAMES[mode][1]
    if f'PKG_TARGET="{pkg}"'.encode() not in raw:
        raise ValueError('El script original no corresponde al juego elegido')
    return raw


def original_coverage(device):
    cmd = ['adb', '-s', device, 'shell', 'sh', '-c', 't=(uno dos); [ "${t[1]}" = dos ]']
    ok, out, err = run(cmd, timeout=8)
    if ok:
        return 'sh', ''
    ok, out, err = run(['adb', '-s', device, 'shell', 'bash', '-c', 't=(uno dos); [ "${t[1]}" = dos ]'], timeout=8)
    if ok:
        return 'bash', ''
    return None, 'No se pudo validar soporte de matrices Bash en el shell remoto'


def run_original(scanner, mode):
    game_name, pkg, _ = GAMES[mode]
    show(f'\n  VERIFICACIÓN ORIGINAL: {game_name}', 'bright')
    raw = legacy_bytes(mode)
    shell_name, problem = original_coverage(scanner.device)
    if not shell_name:
        scanner.source('original_'+mode, False, problem)
        scanner.data['legacy'] = {'juego':mode, 'paquete':pkg, 'sha256':LEGACY_SHA256[mode], 'completado':False, 'motivo':problem}
        show('  No fue posible ejecutar el original de forma compatible; sus reglas se conservan.', 'alert')
        show('  ' + problem, 'muted')
        return
    REPORTS.mkdir(parents=True, exist_ok=True)
    name = f'original_{mode}_{scanner.start.strftime("%Y%m%d_%H%M%S")}.txt'
    target = REPORTS / name
    cmd = ['adb','-s',scanner.device,'shell',shell_name,'-c', 'cd /data/local/tmp && ' + shell_name + ' -s']
    result = {'juego':mode, 'paquete':pkg, 'sha256':LEGACY_SHA256[mode], 'completado':False, 'interprete':shell_name, 'ruta_reporte':str(target), 'wo':[], 'avisos':0}
    scanner.data['legacy'] = result
    printed_count = 0
    context = collections.deque(maxlen=5)
    seen_wo = set()
    size = 0
    started = time.monotonic()
    proc = None
    timed_out = False
    max_seconds = 720
    limit_bytes = 12 * 1024 * 1024
    ansi = re.compile(r'\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1b\\))')
    try:
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0, start_new_session=True)
        import threading
        send_err = []
        def sender():
            try:
                proc.stdin.write(raw)
                proc.stdin.close()
            except (OSError, ValueError) as ex:
                send_err.append(type(ex).__name__)
        feeder=threading.Thread(target=sender, daemon=True)
        feeder.start()
        sel = selectors.DefaultSelector()
        sel.register(proc.stdout, selectors.EVENT_READ)
        pending = b''
        with target.open('w', encoding='utf-8') as report:
            while True:
                if time.monotonic() - started > max_seconds or size >= limit_bytes:
                    timed_out = True
                    break
                events = sel.select(timeout=.5)
                if not events:
                    if proc.poll() is not None:
                        chunk = proc.stdout.read(65536) or b''
                        pending += chunk
                        if not chunk:
                            break
                    else:
                        continue
                else:
                    chunk = os.read(proc.stdout.fileno(), 65536)
                    if not chunk:
                        break
                    pending += chunk
                size += len(chunk)
                lines = pending.split(b'\n')
                pending = lines.pop()
                for blob in lines:
                    line=ansi.sub('', blob.decode('utf-8','replace')).replace('\r','').strip()
                    if not line:
                        continue
                    report.write(line+'\n')
                    if line.startswith(('[!]','[?]','[+]','MOTIVO:', 'RUTA:', 'ARQUIVO')):
                        if line.startswith('[!]'):
                            result['avisos'] += 1
                        if 'APLIQUE O W.O.' in line.upper():
                            reason = next((x for x in reversed(context) if 'MOTIVO:' in x or x.startswith('[!]')), 'Alerta registrada en el script original')
                            if reason not in seen_wo:
                                seen_wo.add(reason)
                                result['wo'].append({'motivo':reason[:230], 'evidencia':str(target), 'juego':mode})
                                scanner.wo.append({'motivo':reason[:230], 'evidencia':str(target), 'juego':mode,'clasificacion':'W.O. original por verificar'})
                            show('  [!] APLIQUE O W.O.!', 'alert')
                        elif printed_count < 260 and (line.startswith('[!]') or line.startswith('[?]') or line.startswith('[+]')):
                            show('  ' + line[:210], 'alert' if line.startswith('[!]') else 'muted')
                            printed_count += 1
                    context.append(line)
            if pending:
                line=ansi.sub('', pending.decode('utf-8','replace')).replace('\r','').strip()
                if line:
                    report.write(line+'\n')
        sel.close()
        if timed_out and proc.poll() is None:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                proc.wait(timeout=4)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
        else:
            proc.wait(timeout=5)
        result['exit_code'] = proc.returncode
        result['completado'] = not timed_out and proc.returncode == 0 and not send_err
        result['bytes_leidos'] = size
        result['duracion_segundos'] = round(time.monotonic() - started,2)
        if timed_out:
            result['motivo'] = 'Tiempo de ejecución o tamaño de salida excedido'
        elif send_err:
            result['motivo'] = 'Transmisión incompleta: ' + ', '.join(send_err)
        elif proc.returncode != 0:
            result['motivo'] = 'Intérprete remoto devolvió código ' + str(proc.returncode)
        scanner.source('original_'+mode, result['completado'], result.get('motivo','Revisar condiciones de acceso por módulo'))
    except KeyboardInterrupt:
        if proc and proc.poll() is None:
            os.killpg(proc.pid, signal.SIGTERM)
        raise
    except (OSError, subprocess.TimeoutExpired, ValueError) as ex:
        result['motivo'] = type(ex).__name__
        scanner.source('original_'+mode, False, result['motivo'])
        if proc and proc.poll() is None:
            os.killpg(proc.pid, signal.SIGTERM)
    show(f'  Archivo original: {"ejecutado" if result["completado"] else "incompleto"}', 'bright' if result['completado'] else 'alert')
    show(f'  Alertas originales W.O.: {len(result["wo"])} | Avisos: {result["avisos"]}', 'muted')
    show('  Registro: '+str(target), 'muted')



def clean_ssid(value):
    name = str(value).strip().strip('"').strip()
    if name.lower() in ('<unknown ssid>', '<hidden>', '<hidden ssid>', 'null', 'none', '0x', ''):
        return ''
    if re.search(r'[\x00-\x1f\x7f]', name) or len(name.encode('utf-8', errors='replace')) > 128:
        return ''
    return name[:64]


def extract_connected_ssids(text):
    output = []
    for line in text.splitlines():
        if not re.search(r'connected to|(?:mWifiInfo|WifiInfo).*SSID',line,re.I):
            continue
        match = re.search(r'connected to\s+["“]([^"”]+)["”]',line,re.I)
        if not match:
            match = re.search(r'(?<![A-Za-z])SSID\s*[:=]\s*(?:"([^"]+)"|([^,\r\n]+))',line,re.I)
        if match:
            candidate = clean_ssid(next((g for g in match.groups() if g),''))
            if candidate and candidate not in output:
                output.append(candidate)
    return output


def extract_scan_ssids(text):
    output = []
    for line in text.splitlines():
        match = re.match(r'^\s*(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\s+\d+\s+-?\d+\s+\S+\s+(.+?)(?:\s+\[.*\])?\s*$',line)
        if not match:
            continue
        name = clean_ssid(match.group(1))
        if name and name not in output:
            output.append(name)
    return output


def redact_sensitive_line(line):
    result = re.sub(r'(?i)(KEY_ACCESS_CHANGED\s*[=:]\s*)\S+',r'\1[REDACTADO]',line)
    result = re.sub(r'(?i)(authorization:\s*(?:bearer|basic)\s+)\S+',r'\1[REDACTADO]',result)
    result = re.sub(r'(?i)((?:password|passwd|token|secret|api[_-]?key)\s*[=:]\s*)\S+',r'\1[REDACTADO]',result)
    return result


class Forense:
    def __init__(self, device, modes, do_restart):
        self.device = device
        self.modes = modes
        self.do_restart = do_restart
        self.start = datetime.datetime.now(datetime.timezone.utc)
        self.stage = 0
        self.total = 15 + 6 * len(modes)
        self.coverage = {}
        self.findings = []
        self.wo = []
        self.data = {'version': VERSION, 'device': device, 'games': modes, 'utc': self.start.isoformat(), 'events': [], 'snapshots': {}, 'games_data': {}, 'signals': {}}
        self.data['profundo'] = {'apk': [], 'memoria': {}, 'logcat': {}, 'red': {}, 'kernel': {}, 'shaders': {}, 'historico': {}, 'correlaciones': [], 'wifi': {}, 'fallos_nativos': {}}
        self.data['evidencias'] = []
        self._deep_prev_shaders = {}

    def shell(self, *args, timeout=12):
        return run(['adb', '-s', self.device, 'shell', *args], timeout)

    def sh(self, cmd, timeout=12):
        return self.shell('sh', '-c', cmd, timeout=timeout)

    def getprop(self, key):
        return self.shell('getprop', key)[1]

    def source(self, name, ok, detail=''):
        self.coverage[name] = {'accesible': bool(ok), 'detalle': detail[:180]}
        if not ok:
            show(f'  [?] No verificable: {name}', 'muted')

    def mark(self, reason, evidence, grade='INDICIO', game=None, wo=False, explanation=''):
        if grade == 'CORRELACION' and not explanation:
            if 'puerto' in reason.lower() or 'instrumentación' in reason.lower():
                explanation = 'Hay coincidencia entre señales de instrumentación y de red. Es necesario confirmar el proceso propietario y su relación temporal con Free Fire.'
            elif 'accesibilidad' in reason.lower() or 'proyección' in reason.lower():
                explanation = 'Se observaron permisos o servicios de asistencia remota funcionando conjuntamente. Su uso puede ser legítimo y no confirma alteración del juego.'
            elif 'debugger' in reason.lower():
                explanation = 'Un proceso del juego apareció bajo seguimiento de otro PID. Debe identificarse el proceso responsable y descartar herramientas legítimas.'
            else:
                explanation = 'Confluyen varias señales técnicas; la coincidencia requiere corroboración independiente antes de atribuirle una modificación del juego.'
        item = {'nivel': grade, 'motivo': reason, 'evidencia': str(evidence)[:500], 'juego': game, 'explicacion': explanation}
        if item not in self.findings:
            self.findings.append(item)
            show(f'  [{grade}] {reason}', 'alert' if grade == 'CORRELACION' else '')
            if grade == 'CORRELACION' and explanation:
                show('      ' + explanation, 'muted')
        if wo:
            w = {'motivo': reason, 'evidencia': str(evidence)[:320], 'juego': game, 'clasificacion': 'W.O. por verificar'}
            if w not in self.wo:
                self.wo.append(w)
                show('  [!] APLIQUE O W.O.!', 'alert')

    def stage_start(self, name):
        self.stage += 1
        self.data['events'].append({'etapa': self.stage, 'nombre': name, 'utc': datetime.datetime.now(datetime.timezone.utc).isoformat()})
        show(f'\n[{self.stage:02d}/{self.total:02d}] {name}', 'bright')

    def stage_end(self, detail=''):
        pct = round(self.stage * 100 / self.total)
        blocks = min(28, round(self.stage * 28 / self.total))
        for tick in ('◐', '◓', '◑', '◒'):
            print(f'\r  {RED}{"█"*blocks}{GRAY}{"░"*(28-blocks)}{RESET} {pct:3}% {tick}', end='', flush=True)
            time.sleep(.035)
        print('\r  ' + RED + '█' * blocks + GRAY + '░' * (28 - blocks) + RESET + f' {pct:3}% ✓', flush=True)
        if detail:
            show('  ' + detail, 'muted')

    def stage_run(self, label, action):
        self.stage_start(label)
        action()
        self.stage_end()

    def system(self):
        props = {key: self.getprop(key) for key in ('ro.product.brand', 'ro.product.model', 'ro.build.version.release', 'ro.build.fingerprint', 'ro.boot.verifiedbootstate', 'ro.boot.vbmeta.device_state', 'ro.debuggable', 'ro.secure', 'ro.build.tags')}
        self.data['props'] = props
        show(f'  Marca: {props.get("ro.product.brand") or "Desconocida"}  |  Modelo: {props.get("ro.product.model") or "?"}')
        show(f'  Android: {props.get("ro.build.version.release") or "?"}')
        if props.get('ro.boot.vbmeta.device_state') == 'unlocked' or props.get('ro.boot.verifiedbootstate') in ('orange', 'red'):
            self.mark('Arranque sin verificación estándar', str(props), 'INDICIO')
        self.source('identidad', bool(props.get('ro.product.model')), 'getprop')

    def adb_config(self):
        vals = {}
        for ns, key in (('global','adb_enabled'), ('global','adb_wifi_enabled'), ('global','http_proxy'), ('global','private_dns_mode'), ('global','private_dns_specifier'), ('secure','enabled_accessibility_services'), ('global','development_settings_enabled')):
            ok, value, error = self.shell('settings', 'get', ns, key)
            vals[f'{ns}:{key}'] = value if ok else None
            self.source('settings_' + key, ok, error)
        self.data['settings'] = vals
        show('  ADB autorizado para este análisis.')
        if vals.get('global:http_proxy') not in ('', 'null', ':0', None):
            self.mark('Proxy configurado', vals['global:http_proxy'])
        if vals.get('global:private_dns_mode') == 'hostname':
            self.mark('DNS privado personalizado', vals.get('global:private_dns_specifier') or '')
        self.data['signals']['adb_properties'] = {key: self.getprop(key) for key in ('persist.sys.usb.config','sys.usb.config','ro.adb.secure','persist.adb.tls_server.enable','service.adb.tls.port','service.adb.tcp.port','persist.adb.tcp.port')}
        self.data['signals']['adb_settings'] = {k:v for k,v in vals.items() if 'adb_' in k}
        self.data['accessibility'] = sorted(set(re.findall(r'([a-zA-Z0-9_.]+)/[a-zA-Z0-9_.$]+', vals.get('secure:enabled_accessibility_services') or '')))

    def wifi_ssids(self):
        sources = {}
        active = []
        available = []
        state_ok, state, state_err = self.shell('settings', 'get', 'global', 'wifi_on', timeout=8)
        self.source('wifi_estado', state_ok, state_err)
        sources['wifi_estado'] = state if state_ok else None
        ok, status, err = self.shell('cmd', 'wifi', 'status', timeout=15)
        self.source('ssid_estado_actual', ok, err)
        sources['estado_actual'] = ok
        if ok:
            active.extend(extract_connected_ssids(status))
        if not active:
            ok_f, fallback, err_f = self.sh('dumpsys wifi 2>/dev/null | grep -m 15 -E "mWifiInfo|WifiInfo"', timeout=18)
            self.source('ssid_wifiinfo', ok_f, err_f)
            sources['wifiinfo'] = ok_f
            if ok_f:
                active.extend(extract_connected_ssids(fallback))
        ok_scan, results, err_scan = self.shell('cmd', 'wifi', 'list-scan-results', timeout=20)
        self.source('ssid_escaneos_cache', ok_scan, err_scan)
        sources['escaneo_cache'] = ok_scan
        if ok_scan:
            available = extract_scan_ssids(results)
        current = sorted(set(active))[:8]
        nearby = [x for x in sorted(set(available)) if x not in current][:50]
        self.data['profundo']['wifi'] = {
            'encendido': state == '1' if state_ok else None,
            'conectado': current,
            'observados_cache': nearby,
            'fuentes': sources,
            'tipo': 'SSID accesibles por Android/ADB; sin clave ni BSSID',
            'advertencia': 'Un SSID, incluidos caracteres Unicode, no demuestra inyección, acceso remoto ni corrupción de memoria.'
        }
        show('  SSID conectado: ' + (', '.join(current) if current else 'no disponible o no conectado'))
        if nearby:
            show('  SSID observados en caché: ' + ', '.join(nearby[:12]), 'muted')
            if len(nearby) > 12:
